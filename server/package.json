    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.2",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.10",
