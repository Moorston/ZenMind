# 数据库
DATABASE_URL=file:./data/meditation.db

# JWT 鉴权（必需）
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# OpenID 加密（必需，用于微信用户 OpenID 加密存储）
OPENID_ENCRYPTION_KEY=your-encryption-key-here
OPENID_ENCRYPTION_SALT=your-encryption-salt-here

# TOS 对象存储（可选，开发时可使用本地媒体）
# TOS_ENDPOINT=https://tos-cn-north-1.volces.com
# TOS_ACCESS_KEY=your-access-key
# TOS_SECRET_KEY=your-secret-key
# TOS_BUCKET=zenmind-media
# TOS_PUBLIC_URL=https://zenmind-media.tos-cn-north-1.volces.com

# 微信小程序（可选）
# WECHAT_APPID=wx-your-appid
# WECHAT_APPSECRET=your-app-secret
# WECHAT_TEMPLATE_ID=your-template-id

# SMTP（可选，用于发送验证码邮件）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-password

# 生产环境跨域配置
# ALLOWED_ORIGINS=https://your-domain.com